import wollok.game.*
import jugador.*
import movimientos.*
import casa.*

program probarCasa {
    game.title("UTN Cross - Casa")
    game.width(20)
    game.height(14)
    game.cellSize(50)

    new NivelCasa().empezar()

    game.addVisual(jugador)
    movimientos.configControles(jugador)

    game.start()
}