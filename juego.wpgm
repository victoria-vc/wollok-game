import wollok.game.*
import wollok.lib.*

object jugador {
    var property position = game.center()
    var direccion = "derecha"

    method image() {
        var asset
        if (direccion == "derecha")
            asset = "derecha.png" 
        if (direccion == "izquierda")
            asset = "izquierda.png"
        if (direccion == "arriba")
            asset = "arriba.png"
        if (direccion == "abajo")
            asset = "abajo.png"
        return asset
    }

    method position(nuevaPosition) {
        if (nuevaPosition.x() > position.x())
            direccion = "derecha"

        if (nuevaPosition.x() < position.x())
            direccion = "izquierda"
        
        if (nuevaPosition.y() > position.y())
            direccion = "arriba"

        if (nuevaPosition.y() < position.y())
            direccion = "abajo"

        position = nuevaPosition
    }
}

class Enemigo{
    var property position
    var direccion = 1
    var property velocidad

    method image() = "bolita.png"

    method esEnemigo() = true

    method mover(){
        if (position.x() > game.width()){
            direccion = -1 * velocidad
        }
        if (position.x() < 0){
            direccion = 1 * velocidad
        }
        position = position.right(direccion)
    }
}


object barrera {
    var abierta = true
    var property position = game.at(1,1)

    method esEnemigo() = false

    method image(){
        if(abierta){
            return "abierta.png"
        }
        else{
            return "cerrada.png"
        }
    }

    method alternar(){
        abierta = !abierta
    }
}



program juego {
    game.width(40)
    game.height(40)
    game.cellSize(50)
    
    game.ground("calle.png")

    const enemigo1 = new Enemigo(position = game.at(10, 5), velocidad=0.1)
    const enemigo2 = new Enemigo(position = game.at(15, 8), velocidad=0.2)
    const enemigo3 = new Enemigo(position = game.at(18, 3), velocidad=0.3)

    game.addVisualCharacter(jugador)
    game.addVisual(enemigo1)
    game.addVisual(enemigo2)
    game.addVisual(enemigo3)
    game.addVisual(barrera)

    

    game.onTick(5, "moverEnemigo", {
        enemigo1.mover()
        enemigo2.mover()
        enemigo3.mover()
    })

    game.onCollideDo(jugador, { objeto =>
        if (objeto.esEnemigo())
            console.println(objeto)
            game.say(jugador, "Perdiste")
    })

    game.onTick(3000, "barrera", {
        barrera.alternar()
    })

    game.start()
}